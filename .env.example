# Variable names only; real values live in .env.local (git-ignored). Never commit secrets.
# Copy this file to .env.local and fill it in.

# Supabase project (Project settings > API)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
# Secret key: only for scripts and tests (user:create, seed:demo, check:*), never used while serving requests
SUPABASE_SECRET_KEY=
# Optional, only for `supabase db push`
SUPABASE_DB_PASSWORD=

# Real Chrome: server-side PDF and the check:* scripts. Usually leave it empty: Chrome is found in .chrome/
# (npm run chrome:install) or in the usual place on Windows, macOS and Linux. Set it only for a Chrome elsewhere.
CHROME_PATH=
# Where that Chrome reaches this server to open the print page (default http://127.0.0.1:6438)
INTERNAL_BASE_URL=http://127.0.0.1:6438

# Optional: hostnames (no port) other than localhost allowed to reach the dev server, comma separated,
# e.g. a forwarded public DNS name
ALLOWED_DEV_ORIGINS=

# Optional extra Chrome flags, space separated (in a container: --no-sandbox --disable-dev-shm-usage)
CHROME_ARGS=
